{
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "App.tsx",
    "mobile/src/constants/**/*.ts",
    "mobile/src/features/**/*.ts",
    "mobile/src/lib/**/*.ts",
    "mobile/src/theme/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src",
    ".next",
    "prisma"
  ],
  "extends": "expo/tsconfig.base"
}
